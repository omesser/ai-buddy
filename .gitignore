# Rust — the workspace target, plus the pre-workspace one that old checkouts
# may still carry
/target/
/src-tauri/target/

# Tauri code generation
/src-tauri/gen/

# Manual verification artifacts (screenshots, window dumps, app logs)
/.verify/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Logs & temp
*.log
*.tmp
tmp/

# Local environment / secrets
.env
.env.*
!.env.example

# Claude Code's working directory: local settings, and the throwaway worktrees
# subagents are given. Those worktrees are checkouts of this repository, so
# committing one would nest a clone inside itself.
#
# The whole directory rather than the local-only files inside it. Nothing here
# has ever been shared, and an ignore that lists what to skip goes stale the
# moment the tool adds something new. Un-ignore a specific path with `!` if a
# file here ever becomes worth committing.
.claude/
