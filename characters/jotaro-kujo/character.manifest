# Jotaro Kujo imported from petscodex (petdex) by scripts/import-pet.py.
# Source pet id: jotaro-kujo — https://petscodex.com/pets/jotaro-kujo
# Source description: A chibi Jotaro Kujo-style Codex pet.
# Hand-tuned after import based on actual spritesheet art (petscodex labels
# do not match this pet's frames). Spritesheet: 8x9 grid of 192x208 cells.
# Final mapping: idle+waiting<-row 0[0,1] at fps=2 (blink, destrobed from 6),
# walk<-row 2[0-7] mirrored to head right (8-frame two-step cycle),
# sit<-row 7[2-5] (cross-legged sit, 4 frames), sleep<-row 6[4,5] (lying
# down, 2 frames), land<-row 6[0,1] (crouch), talk<-row 8 (gestures, 6),
# react<-row 5 (Stand aura, 8), fall/hold<-row 4 (run/lunge).
# All frames: 1px silhouette erode + re-ground to remove green chroma halo.
# License: none declared anywhere in the source ecosystem;
# accepted at import with --accept-license. A development asset
# unless a license surfaces — this repository's license claims
# do not cover the art.

name = "Jotaro Kujo"
render_mode = "smooth"
scale = 1

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 2

[animations.waiting]
frames = ["frames/waiting-0.png", "frames/waiting-1.png"]
fps = 2
variant_of = "idle"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 8

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png", "frames/talk-4.png", "frames/talk-5.png"]
fps = 6

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 6
loop = "once"

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 6

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png", "frames/react-5.png", "frames/react-6.png", "frames/react-7.png"]
fps = 7
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 2

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

# A starter life, copied from BMO's — tune it to the pet.
[behaviors.walk]
play = ["walk"]
weight = 1
when = "idle over 30s"

[behaviors.patrol]
play = ["walk", "idle", "walk"]
then = "walk"
weight = 3
when = "idle over 2m"

[behaviors.fidget]
play = ["idle"]
weight = 2
when = "idle over 10s"

[behaviors.report]
play = ["talk", "idle", "talk"]
weight = 3
when = "idle under 1m"

[behaviors.greet]
play = ["talk"]
then = "patrol"
weight = 4
when = "idle under 10s"
