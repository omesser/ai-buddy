# Blip, the stand-in. Not art — it gives the renderer nine
# visibly different Animations to play, and the hit-test something with
# transparent regions to test against. Regenerate the frames with
# scripts/make-blip-character.py.

name = "Blip"

# Unused model calls: after each one nobody answered, the wait becomes
# wait * model_base ^ model_power. Two and one doubles.

[director]
model_base = 2
model_power = 1

# Cadence per Animation, which is the point of declaring it: a slow idle and a
# fast walk are the same eight frame counts playing at different speeds.

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 3

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png"]
fps = 12

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 8

# Landing and reacting are events. They play through once and hold their last
# frame rather than looping, which is what stops a landed sprite from squashing
# itself every half second for ever.

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/land-2.png"]
fps = 14
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png"]
fps = 2

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 8

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png"]
fps = 12
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png"]
fps = 10

# The weights and conditions are what Blip does with no model configured. The
# Static Director draws from these by weight, so this is the whole of its idle
# life: greet whoever is at the keyboard, wander once they stop typing, and
# settle down once they have plainly gone.

[behaviors.greet]
play = ["react", "talk"]
then = "settle"
weight = 2
when = "idle under 10s"

[behaviors.settle]
play = ["sit", "sleep"]
weight = 3
when = "idle over 2m"

# The one Behavior that moves the sprite anywhere, so a Director has something
# to propose beyond expression. The name is the Director's handle on it; what
# walks is the `walk` Primitive inside.

[behaviors.walk]
play = ["walk"]
weight = 3
when = "idle over 10s"
