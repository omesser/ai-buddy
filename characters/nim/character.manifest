# Nim, a modern pixel-art character... creature ... thing. He's nice.

name = "Nim"

[source]
art = """
Original to this repository. Every frame is drawn by \
scripts/make-shipped-characters.py rather than cut from a pack."""
license = """
MIT for the whole package — prose, manifest and art are all this project's \
own. Every frame is drawn by scripts/make-shipped-characters.py."""

# Proactive model calls: after each one with no one addressing the buddy,
# the wait becomes wait * model_base ^ model_power. Two and one doubles.

[director]
model_base = 2
model_power = 1

# Cursor reactions: attentive and cautious, observes but startles at sudden movement.
[cursor]
near_reaction = "face"
rush_reaction = "away"

# Twice BMO's frames everywhere, played fast enough that the in-betweens are
# seen rather than sat through. Sleep is the exception: a breath that slow is
# the point of it.

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png", "frames/idle-2.png", "frames/idle-3.png", "frames/idle-4.png", "frames/idle-5.png"]
fps = 8

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 12

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png", "frames/fall-2.png"]
fps = 8

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/land-2.png", "frames/land-3.png"]
fps = 12
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 8

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png", "frames/hold-2.png", "frames/hold-3.png"]
fps = 8
loop = "once"

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png", "frames/sleep-2.png", "frames/sleep-3.png"]
fps = 3

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png"]
fps = 12
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png", "frames/talk-4.png", "frames/talk-5.png"]
fps = 10

# Nim comes to rest. Every Behavior here but the walk ends sitting or asleep,
# which is the whole difference between living with Nim and living with BMO.
#
# What Nim does with no model configured, and the inverse of BMO's balance:
# nothing here stays on its feet for long. The arc: notice whoever arrived —
# late, and over a window three times blip's, because Nim is slow to notice
# anything — stretch and amble towards somewhere to sit once they stop typing,
# say the thing it saw a long moment after the fact, and sleep once they have
# plainly gone. Eleven hours a day asleep is a fact about a clock, and no
# manifest can name one, so it is written here as the deepest idle band.
#
# The bands overlap by ten seconds, so no instant of the day is one where Nim
# has nothing it may do.
#
# `doze` outweighs everything in the only phase it now fires, which is what
# those eleven hours look like from a Behavior table. `amble` is lighter than
# `stretch` because both end with Nim off its feet and only one makes it walk
# there first, and `walk` — the one Behavior that neither starts nor ends at
# rest — stays what Nim would least rather be doing.

[behaviors.walk]
play = ["walk"]
weight = 10
when = "idle under 30s"

[behaviors.doze]
play = ["sit", "sleep"]
weight = 50
when = "idle over 2m"

[behaviors.amble]
play = ["walk", "sit"]
then = "doze"
weight = 10
when = "idle over 20s"

[behaviors.stretch]
play = ["idle", "sit"]
then = "doze"
weight = 30
when = "idle over 20s"

[behaviors.mumble]
play = ["talk", "sit"]
weight = 20
when = "idle over 1m"

[behaviors.greet]
play = ["react", "talk"]
then = "doze"
weight = 20
when = "idle under 30s"
