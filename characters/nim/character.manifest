# Nim, the modern pixel-art Character: a palette larger than sixteen colours,
# shaded on a ramp lit from the upper left, a translucent contact shadow, and
# enough in-between frames that the motion eases rather than steps.
# Regenerate the frames with scripts/make-shipped-characters.py.

name = "Nim"

# Twice BMO's frames everywhere, played fast enough that the in-betweens are
# seen rather than sat through. Sleep is the exception: a breath that slow is
# the point of it.

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png", "frames/idle-2.png", "frames/idle-3.png", "frames/idle-4.png", "frames/idle-5.png"]
fps = 8

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 12

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png", "frames/fall-2.png"]
fps = 8

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/land-2.png", "frames/land-3.png"]
fps = 12
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 8

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png", "frames/hold-2.png", "frames/hold-3.png"]
fps = 8
loop = "once"

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png", "frames/sleep-2.png", "frames/sleep-3.png"]
fps = 3

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png"]
fps = 12
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png", "frames/talk-4.png", "frames/talk-5.png"]
fps = 10

# Nim comes to rest. Every Behavior here but the walk ends sitting or asleep,
# which is the whole difference between living with Nim and living with BMO.
#
# The weights are what Nim does with no model configured, and the inverse of
# BMO's balance: eleven hours a day asleep is a distribution, so `doze`
# outweighs everything and `walk` — the one Behavior that neither ends nor
# starts at rest — is what Nim would least rather be doing.

[behaviors.walk]
play = ["walk"]
weight = 1

[behaviors.doze]
play = ["sit", "sleep"]
weight = 5

[behaviors.amble]
play = ["walk", "sit"]
then = "doze"
weight = 2

[behaviors.stretch]
play = ["idle", "sit"]
then = "doze"
weight = 3

[behaviors.mumble]
play = ["talk", "sit"]
weight = 2

[behaviors.greet]
play = ["react", "talk"]
then = "doze"
weight = 2
