# Chip, the faithful Win95 Character: the sixteen VGA colours, flat fills, the
# raised-button bevel of the era, and ordered dithering wherever a shade
# between two of those colours is wanted. Regenerate the frames with
# scripts/make-shipped-characters.py.

name = Chip

animation idle = frames/idle-0.png frames/idle-1.png
animation walk = frames/walk-0.png frames/walk-1.png frames/walk-2.png frames/walk-3.png
animation fall = frames/fall-0.png frames/fall-1.png
animation land = frames/land-0.png frames/land-1.png
animation sit = frames/sit-0.png frames/sit-1.png
animation sleep = frames/sleep-0.png frames/sleep-1.png
animation react = frames/react-0.png frames/react-1.png
animation talk = frames/talk-0.png frames/talk-1.png frames/talk-2.png

# Two or three frames each, held hard and cut fast. A machine from 1995 snaps
# between poses; the cadence is where that reads, not the drawing.
fps idle = 4
fps walk = 10
fps fall = 8
fps land = 12
fps sit = 3
fps sleep = 2
fps react = 12
fps talk = 10

loop land = once
loop react = once

# Chip does not rest. Every Behavior here ends on its feet, which is what a
# Character who thinks a screensaver is a moral failing looks like from the
# outside: the sit and sleep art exists, and only the Engine's own idling ever
# reaches it.
behavior walk = walk
behavior patrol = walk react walk then walk
behavior fidget = react idle react
behavior report = talk react talk
behavior greet = react talk then patrol
