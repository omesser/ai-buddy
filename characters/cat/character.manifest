# Cat imported from petscodex (petdex) by scripts/import-pet.py.
# Source pet id: cat — https://petscodex.com/pets/cat
# Source description: A chibi gray-and-white Scottish Fold cat Codex pet based on the reference photo.
# Mapping: idle<-row 0, walk<-running-left row 2
# (the row drawn heading right), talk<-waving row 3,
# fall/land/hold<-jumping row 4, react<-failed row 5, waiting<-row 6
# (idle variant), sit<-review row 8; sleep is idle's stillest frame
# with a one-pixel breath. The other walk row (the engine mirrors
# instead) and row 7 (running in place) go unused.
# Remapped for this pet's art (--map): sleep<-row 5[2].
# License: none declared anywhere in the source ecosystem, and
# the importer warned so. A development asset unless a license
# surfaces — this repository's license claims do not cover the
# art.

name = "Cat"
render_mode = "smooth"
scale = 1

# Proactive model calls: Cat supervises the desk, so the wait does not grow.
# One and one keeps every two minutes.

[director]
model_base = 1
model_power = 1

# Cursor reactions: curious and playful, comes to investigate but startles easily.
[cursor]
near_reaction = "toward"
rush_reaction = "away"

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png", "frames/idle-2.png", "frames/idle-3.png", "frames/idle-4.png", "frames/idle-5.png"]
fps = 5

[animations.waiting]
frames = ["frames/waiting-0.png", "frames/waiting-1.png", "frames/waiting-2.png", "frames/waiting-3.png", "frames/waiting-4.png", "frames/waiting-5.png"]
fps = 6
variant_of = "idle"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 8

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png"]
fps = 6

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

# Land ends on idle's rest frame, which the jump row does not provide: its
# last frame is a yellow electric burst, and `loop = "once"` holds an
# animation's last frame — so the row alone leaves the cat wreathed in
# lightning for 430 of the Land Primitive's 600ms, which reads as damage
# rather than as impact. Ending on the pose idle opens with keeps the row's
# own drop-and-flash, leaves the burst a 170ms beat, and hands over to idle
# without a step. A hand edit `--map` cannot express, since the rest frame
# is row 0: a re-import drops it. #122.
[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/idle-0.png"]
fps = 6
loop = "once"

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 6

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png", "frames/react-5.png", "frames/react-6.png", "frames/react-7.png"]
fps = 7
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png", "frames/sit-4.png", "frames/sit-5.png"]
fps = 6

[animations.sleep]
frames = ["frames/sleep-0.png"]
fps = 1

# Curiosity first, which is the whole of this cat. It investigates while you
# are there and remarks on what it found; it prowls its territory once you
# stop; it curls up only after you have plainly gone. The arc: ask what you
# are doing the moment you arrive, keep investigating and commenting while
# you are at the keyboard, walk the desk when the typing stops, sit and
# supervise, and sleep last of all.
#
# `inspect` is the heaviest thing it may do while somebody is there, which is
# what "wants to know what everything is" looks like in a Behavior table.
# `nap` is the one Behavior kept for an empty desk. The bands overlap so no
# instant of the day leaves it nothing it may do.

[behaviors.greet]
play = ["talk"]
then = "inspect"
weight = 3
when = "idle under 10s"

[behaviors.inspect]
play = ["walk", "idle"]
weight = 4
when = "idle under 1m"

[behaviors.remark]
play = ["talk", "idle"]
weight = 2
when = "idle under 1m"

[behaviors.groom]
play = ["idle"]
weight = 2
when = "idle over 10s"

[behaviors.prowl]
play = ["walk", "idle", "walk"]
then = "groom"
weight = 3
when = "idle over 30s"

[behaviors.supervise]
play = ["sit"]
weight = 3
when = "idle over 1m"

[behaviors.nap]
play = ["sit", "sleep"]
weight = 4
when = "idle over 2m"

# Chasing the cursor is the fixation the personality admits to only by
# denying it, so it stays light against the investigating.
[behaviors.play-with-cursor]
play = ["chase"]
weight = 2
when = "idle over 1m"
