# White background made transparent, padded to 37x33 with feet on the bottom,
# flipped to face right for engine mirroring. Sit is 4-frame vertical breath.
# Sleep is hunkered sit with eyes closed (not the KO/fall pose). Hold bobs 1px.
# Land-1 is fall tuck, not a duplicate of land-0. Talk alternates stand and
# cast. The old KO sleep pose remains as fall-0 and land-0. Pixel art at scale
# 3 for desktop readability.

name = "Black Mage"
scale = 3

[source]
art = """
Final Fantasy I's Black Mage, sliced from a custom sprite sheet by GigaGuy on \
The Spriters Resource (asset 17261). The voice is Black Mage \
Evilwizardington from Brian Clevinger's 8-Bit Theater (Nuklear Power), not \
the silent FF1 class."""
license = """
None declared for the sprite sheet. Final Fantasy is Square Enix IP and the \
sheet is fan art, so the character is a development asset and none of this \
repository's license claims cover the art."""

# Proactive model calls: after each one with no one addressing the buddy,
# the wait becomes wait * model_base ^ model_power. Two and one doubles.

[director]
model_base = 2
model_power = 1

# Cursor reactions: antisocial and irritable, avoids attention and reacts with annoyance.
[cursor]
near_reaction = "away"
rush_reaction = "react"

[animations.idle]
frames = [
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-1.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-0.png",
  "frames/idle-2.png",
]
fps = 1

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png"]
fps = 8

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = [
  "frames/land-0.png",
  "frames/land-1.png",
  "frames/land-2.png",
  "frames/land-3.png"
]
fps = 10
loop = "once"

[animations.sit]
frames = [
  "frames/sit-0.png",
  "frames/sit-1.png",
  "frames/sit-1.png",
  "frames/sit-2.png",
  "frames/sit-3.png",
  "frames/sit-3.png"
]
fps = 3

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 2

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 8
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png"]
fps = 3

# Greets by announcing himself, idles by seething, only powers down when
# nothing is left to insult. The arc: greet loud, stand idle most of the time,
# sit when idle persists, sleep deeply after long absence.

[behaviors.greet]
play = ["react", "talk"]
then = "ponder"
weight = 30
when = "idle under 10s"

[behaviors.ponder]
play = ["idle"]
weight = 40
when = "idle over 10s"

[behaviors.settle]
play = ["sit"]
then = "meditate"
weight = 30
when = "idle over 1m"

[behaviors.meditate]
play = ["sit", "sleep"]
weight = 50
when = "idle over 2m"

[behaviors.walk]
play = ["walk"]
weight = 10
when = "idle over 30s"
