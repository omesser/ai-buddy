# BMO, the little living console: a mint shell in eight flat colours, hard
# pixel edges, no anti-aliasing, and ordered dithering only where a shade
# between two of those eight is genuinely wanted. Everything it feels shows on
# the screen in its face. Regenerate the frames with
# scripts/make-shipped-characters.py.

name = "BMO"

# Two or three frames each, held hard and cut fast. A handheld answers the
# instant a button is pressed; the cadence is where that reads, not the drawing.

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 4

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png"]
fps = 10

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 8

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 12
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png"]
fps = 3

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 8

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 2

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 12
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png"]
fps = 10

# BMO does not settle. Every Behavior here ends on its feet, which is what a
# Character who would rather be playing looks like from the outside: the sit and
# sleep art exists, and only the Engine's own idling ever reaches it.
#
# What BMO does with no model configured. The arc: say hello to whoever is at
# the keyboard, keep announcing for a minute after they stop in case anybody is
# still listening, and walk the desk once they have plainly gone. That last
# phase is still an active one — BMO does not settle, so being alone is a
# circuit to patrol rather than somewhere to sit down.
#
# The bands overlap rather than meeting at a point. Two conditions that met
# exactly at 10s would leave BMO with nothing eligible at that instant.
#
# Weights balance within a phase now, not across the whole day. `greet`
# outranks `report` in the seconds somebody is actually there, because a
# Character this pleased to see you says hello before it files a report;
# `report` outranks the fidgeting in the minute after they stop, which is the
# only stretch it still has an audience for. `walk` stays lightest: it is the
# bare Primitive, and `patrol` is the same walk with BMO looking at something.

[behaviors.walk]
play = ["walk"]
weight = 1
when = "idle over 30s"

[behaviors.patrol]
play = ["walk", "react", "walk"]
then = "walk"
weight = 3
when = "idle over 2m"

[behaviors.fidget]
play = ["react", "idle", "react"]
weight = 2
when = "idle over 10s"

[behaviors.report]
play = ["talk", "react", "talk"]
weight = 3
when = "idle under 1m"

[behaviors.greet]
play = ["react", "talk"]
then = "patrol"
weight = 4
when = "idle under 10s"
