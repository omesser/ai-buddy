# BMO from the shimejishop free pack, drawn art rather than pixel art: soft
# lines, anti-aliased edges, and the render_mode ADR-0006 reserved for
# exactly this. Every frame is cut from the pack's 46 and flipped to head
# right — the Engine's facing mirrors it back for leftward travel. At scale 1
# the sprite stands its authored size, which is the size a shimeji stands.
# The frames are static art; scripts/make-shipped-characters.py draws Nim
# only.

name = "BMO"
render_mode = "smooth"
scale = 1

# The idle is the pack's singing loop — a BMO with nothing to do hums to
# itself — and the sit is its self-play set: four games on its own screen.

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png"]
fps = 1

[animations.sing]
frames = ["frames/sing-0.png", "frames/sing-1.png", "frames/sing-2.png", "frames/sing-3.png"]
fps = 3
variant_of = "idle"

# A variant is more art for the same life: the renderer cycles the ring —
# base first and three times as long, then each variant — in whole loops.
# Idling, BMO mostly stands; now and then it sings, or rides its skateboard.
# Walking, it sometimes dribbles a football the whole way.

[animations.skate]
frames = ["frames/skate-0.png", "frames/skate-1.png", "frames/skate-0.png", "frames/skate-2.png"]
fps = 3
variant_of = "idle"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-1.png"]
fps = 8

[animations.ballwalk]
frames = ["frames/ballwalk-0.png", "frames/ballwalk-1.png"]
fps = 5
variant_of = "walk"

# Climbing is the one optional Animation the engine itself asks for, scaling
# a display edge; a package without it climbs in its walk art.

[animations.climb]
frames = ["frames/climb-0.png", "frames/climb-1.png", "frames/climb-2.png"]
fps = 4

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png"]
fps = 8
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png"]
fps = 1

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 4

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png"]
fps = 10
loop = "once"

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png"]
fps = 6

# BMO does not settle. Every Behavior here ends on its feet, which is what a
# Character who would rather be playing looks like from the outside: the sit and
# sleep art exists, and only the Engine's own idling ever reaches it.
#
# What BMO does with no model configured. The arc: say hello to whoever is at
# the keyboard, keep announcing for a minute after they stop in case anybody is
# still listening, and walk the desk once they have plainly gone. That last
# phase is still an active one — BMO does not settle, so being alone is a
# circuit to patrol rather than somewhere to sit down.
#
# The bands overlap rather than meeting at a point. Two conditions that met
# exactly at 10s would leave BMO with nothing eligible at that instant.
#
# Weights balance within a phase now, not across the whole day. `greet`
# outranks `report` in the seconds somebody is actually there, because a
# Character this pleased to see you says hello before it files a report;
# `report` outranks the fidgeting in the minute after they stop, which is the
# only stretch it still has an audience for. `walk` stays lightest: it is the
# bare Primitive, and `patrol` is the same walk with BMO looking at something.

# The react art is a wince, and it belongs to being poked or dropped — the
# engine plays it there on its own. Written into these Behaviors it fired on
# nearly every Director wake and read as BMO getting hurt mid-walk, so the
# pauses here are calm ones: standing, talking, or sitting down to a game.

[behaviors.walk]
play = ["walk"]
weight = 1
when = "idle over 30s"

[behaviors.patrol]
play = ["walk", "idle", "walk"]
then = "walk"
weight = 3
when = "idle over 2m"

[behaviors.fidget]
play = ["idle", "sit", "idle"]
weight = 2
when = "idle over 10s"

[behaviors.report]
play = ["talk", "idle", "talk"]
weight = 3
when = "idle under 1m"

[behaviors.greet]
play = ["talk"]
then = "patrol"
weight = 4
when = "idle under 10s"
