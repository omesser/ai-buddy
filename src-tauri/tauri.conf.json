{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fidget",
  "version": "0.1.0",
  "identifier": "dev.omesser.fidget",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "dmg",
      "appimage",
      "deb",
      "nsis"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../characters": "characters"
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/omesser/fidget/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEOEI4QjE3QzY0QjU5QTcKUldUTm5qZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqZ0NqCg=="
    }
  }
}
